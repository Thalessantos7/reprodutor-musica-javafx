<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="500.0" prefWidth="800.0"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.reprodutormusicajavafx.PlayerController"
            style="-fx-background-color: #1a1a2e;">

   <top>

      <VBox alignment="CENTER" spacing="5"
            style="-fx-padding: 20; -fx-background-color: #16213e;">

         <Label text="Arial"
                style="-fx-font-size: 28px; -fx-font-weight: bold;
                      -fx-text-fill: #e94560; -fx-font-family: 'Arial';"/>

         <Label fx:id="labelTitulo" text="Nenhuma música selecionada"
                style="-fx-font-size: 18px; -fx-font-weight: bold;
                      -fx-text-fill: #e0e0e0; -fx-font-family: 'Arial';"/>

         <Label fx:id="labelArtista" text="---"
                style="-fx-font-size: 13px; -fx-text-fill: #a0a0b0;
                      -fx-font-family: 'Arial';"/>

      </VBox>

   </top>

   <center>

      <ListView fx:id="listaMusicas"
                style="-fx-background-color: #1a1a2e;
                         -fx-control-inner-background: #1a1a2e;
                         -fx-text-fill: #e0e0e0;
                         -fx-font-size: 13px;
                         -fx-font-family: 'Arial';
                         -fx-border-color: #0f3460;
                         -fx-border-width: 1px;"/>
   </center>

   <bottom>

      <VBox alignment="CENTER" spacing="12"
            style="-fx-padding: 15; -fx-background-color: #16213e;">

         <Slider fx:id="sliderProgresso" min="0" max="100" value="0"
                 prefWidth="750"
                 style="-fx-accent: #e94560;"/>

         <HBox alignment="CENTER" spacing="15">

            <Button fx:id="btnAnterior" text="⏮" onAction="#anterior"
                    prefWidth="50" prefHeight="40"
                    style="-fx-background-color: #0f3460;
                               -fx-text-fill: #e0e0e0;
                               -fx-font-size: 16px;
                               -fx-cursor: hand;
                               -fx-background-radius: 8;"/>

            <Button fx:id="btnPlay" text="▶ Play" onAction="#play"
                    prefWidth="100" prefHeight="40"
                    style="-fx-background-color: #e94560;
                               -fx-text-fill: white;
                               -fx-font-size: 14px;
                               -fx-font-weight: bold;
                               -fx-cursor: hand;
                               -fx-background-radius: 8;"/>

            <Button fx:id="btnStop" text="⏹ Stop" onAction="#stop"
                    prefWidth="100" prefHeight="40"
                    style="-fx-background-color: #0f3460;
                               -fx-text-fill: #e0e0e0;
                               -fx-font-size: 14px;
                               -fx-cursor: hand;
                               -fx-background-radius: 8;"/>

            <Button fx:id="btnProxima" text="⏭" onAction="#proxima"
                    prefWidth="50" prefHeight="40"
                    style="-fx-background-color: #0f3460;
                               -fx-text-fill: #e0e0e0;
                               -fx-font-size: 16px;
                               -fx-cursor: hand;
                               -fx-background-radius: 8;"/>

         </HBox>

         <HBox alignment="CENTER" spacing="10">

            <Label text="🔊 Volume:"
                   style="-fx-text-fill: #a0a0b0; -fx-font-size: 13px;"/>

            <Slider fx:id="sliderVolume" min="0" max="1" value="0.5"
                    prefWidth="150"
                    style="-fx-accent: #e94560;"/>

         </HBox>

         <HBox alignment="CENTER" spacing="15">

            <Button fx:id="btnAdicionar" text="＋ Adicionar Música"
                    onAction="#adicionarMusica"
                    prefWidth="160" prefHeight="35"
                    style="-fx-background-color: #0f3460;
                               -fx-text-fill: #e0e0e0;
                               -fx-font-size: 13px;
                               -fx-cursor: hand;
                               -fx-background-radius: 8;"/>

            <Button fx:id="btnRemover" text="✖ Remover Música"
                    onAction="#removerMusica"
                    prefWidth="160" prefHeight="35"
                    style="-fx-background-color: #3d1a1a;
                               -fx-text-fill: #e94560;
                               -fx-font-size: 13px;
                               -fx-cursor: hand;
                               -fx-background-radius: 8;"/>

         </HBox>

      </VBox>

   </bottom>

</BorderPane>